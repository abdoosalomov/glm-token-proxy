# Copy to .env and fill in. Never commit .env.

# OAuth token endpoint (client_credentials)
GLM_TOKEN_URL=https://<host>/api/v1/token

# Chat completions endpoint (OpenAI format)
GLM_API_URL=https://<host>/<path>/v1/chat/completions

# Credentials from your provider
GLM_CLIENT_ID=
GLM_CLIENT_SECRET=

# Local port the proxy listens on
PORT=8787

# Refresh token this many seconds before expiry (token lives 1800s)
REFRESH_MARGIN_S=300
